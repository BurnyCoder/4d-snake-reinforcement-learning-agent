# .env.example - every configuration key snake4d understands, with its default value.
# Copy to .env and edit; keys are SNAKE_<FIELD> for the fields of src/snake4d/config.py:Config.
# Loaded by python-dotenv (https://pypi.org/project/python-dotenv/); shell variables win over .env,
# `--env-file experiments/expNN.env` wins over both, `--set field=value` wins over everything.

# --- game -------------------------------------------------------------------------------------
SNAKE_SIZE=4            # cells per axis; the board has SIZE**NDIM cells (4^4 = 256)
SNAKE_NDIM=4            # number of dimensions (2 = classic snake, 4 = the headline game)
SNAKE_IDLE_MULT=4       # starvation: truncate after more than IDLE_MULT * n_cells consecutive idle steps

# --- rewards ----------------------------------------------------------------------------------
SNAKE_R_FOOD=1.0        # reward for eating
SNAKE_R_DEATH=-1.0      # wall / self collision (terminal)
SNAKE_R_WIN=10.0        # snake length == n_cells (terminal, the objective)
SNAKE_R_STEP=-0.001     # every non-terminal step (must satisfy |R_STEP|/(1-GAMMA) < |R_DEATH|)
SNAKE_SHAPING_COEF=0.0  # potential-based shaping weight; 0 disables (default)

# --- PPO (sb3-contrib MaskablePPO) ------------------------------------------------------------
SNAKE_N_ENVS=4096       # batched environments in the single-process SnakeVecEnv (docs/benchmark.md)
SNAKE_TOTAL_TIMESTEPS=20000000
SNAKE_N_STEPS=64        # rollout length per env (rollout size = N_STEPS * N_ENVS)
SNAKE_BATCH_SIZE=8192   # minibatch size; must divide N_STEPS * N_ENVS (docs/benchmark.md)
SNAKE_N_EPOCHS=4
SNAKE_GAMMA=0.99
SNAKE_GAE_LAMBDA=0.95
SNAKE_LR_START=0.0003   # linear schedule start -> end
SNAKE_LR_END=0.00001
SNAKE_CLIP_START=0.2    # linear clip-range schedule start -> end
SNAKE_CLIP_END=0.05
SNAKE_ENT_COEF=0.01
SNAKE_VF_COEF=0.5
SNAKE_MAX_GRAD_NORM=0.5
SNAKE_TARGET_KL=0.03
SNAKE_NET_WIDTH=512     # MLP hidden width for both policy and value heads ([W, W])
SNAKE_DEVICE=auto       # auto | cpu | cuda (docs/benchmark.md lists the measured best; bench never edits this file)
SNAKE_TORCH_THREADS=8   # torch.set_num_threads (8 beat 1 on every CPU row of docs/benchmark.md; no effect on cuda)
SNAKE_SEED=0

# --- curriculum (Backplay reverse curriculum along the Hamiltonian route) ---------------------
SNAKE_CURRICULUM=1          # 1 = on, 0 = off
SNAKE_CURRICULUM_WINDOW=4   # start length is sampled from [hi - WINDOW, hi]
SNAKE_CURRICULUM_DELTA=0    # frontier step; 0 -> max(1, n_cells // 64)
SNAKE_CURRICULUM_RHO=0.9    # advance the frontier when curriculum success rate exceeds RHO (exp02d)
SNAKE_CURRICULUM_MIN_EPS=500
SNAKE_P_TRUE_START=0.2      # fraction of resets that always start from length 1

# --- evaluation -------------------------------------------------------------------------------
SNAKE_EVAL_EPISODES=100
SNAKE_EVAL_EVERY=2097152    # env steps between in-training evaluations (>= N_STEPS * N_ENVS)
SNAKE_CKPT_EVERY=8388608    # env steps between checkpoints
SNAKE_EVAL_SEEDS=0,1,2
SNAKE_BENCH_STEPS=200000    # bench: PPO timesteps per benchmark row
SNAKE_BENCH_BATCH_SIZES=2048,8192,16384   # bench: minibatch sweep on the best grid row

# --- paths / phase arguments ------------------------------------------------------------------
SNAKE_RUNS_DIR=runs
SNAKE_RUN_NAME=run
SNAKE_MODEL_PATH=           # a saved MaskablePPO .zip, or the name of a train/imitate run under RUNS_DIR (newest run, its evaluated checkpoint): evaluate/watch play it (empty = scripted policy), train warm-starts / resumes from it
SNAKE_POLICY=route          # evaluate/watch: route | random (when MODEL_PATH is empty)

# --- watching (phase `watch`: `uv run snake4d watch --set model_path=<run name or .zip>`) --------
SNAKE_WATCH_SPEED=8         # moves per second; the +/- keys double / halve it while watching
SNAKE_DETERMINISTIC=1       # 1 = argmax move (the mode of the reported scores), 0 = sample from the policy
SNAKE_WATCH_GIF=0           # 1 = record the first game to runs/<ts>_watch_<name>/game.gif (Pillow)

# --- imitation warm start (phase `imitate`, then `train --set model_path=.../bc_model.zip`) -----
SNAKE_BC_EPOCHS=20          # passes over the N_ENVS * N_STEPS expert samples
SNAKE_BC_LR=0.001           # Adam learning rate for behaviour cloning

# --- publishing (phase `publish`: `uv run --group hub snake4d publish --set runs_dir=...`) -----
# The Hub token is NOT a snake4d key: log in once with `hf auth login` (or export HF_TOKEN).
SNAKE_PUBLISH_RUNS=exp02_ppo_2x4,exp02b_ppo_2x4_backplay,exp02c_ppo_2x4_long,exp02d_ppo_2x4_backplay_strict,exp03a_ppo_3x4_nocur,exp03b_ppo_3x4_backplay,exp03c_ppo_3x4_backplay_relaxed,exp04_ppo_4x4,exp05_bc_4x4,exp05b_ppo_4x4_from_bc
SNAKE_HF_NAMESPACE=BurnyCoder                          # Hub user or organisation that owns the repos
SNAKE_HF_COLLECTION=4D Snake RL: all evaluated networks  # collection title (found by title, created once)
SNAKE_HF_PRIVATE=0                                     # 1 = private repos and collection
