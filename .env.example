# .env.example - every configuration key snake4d understands, with its default value.
# Copy to .env and edit; keys are SNAKE_<FIELD> for the fields of src/snake4d/config.py:Config.
# Loaded by python-dotenv (https://pypi.org/project/python-dotenv/); shell variables win over .env,
# `--env-file experiments/expNN.env` wins over both, `--set field=value` wins over everything.

# --- game -------------------------------------------------------------------------------------
SNAKE_SIZE=4            # cells per axis; the board has SIZE**NDIM cells (4^4 = 256)
SNAKE_NDIM=4            # number of dimensions (2 = classic snake, 4 = the headline game)
SNAKE_IDLE_MULT=4       # starvation cap = IDLE_MULT * n_cells steps without eating (truncation)

# --- rewards ----------------------------------------------------------------------------------
SNAKE_R_FOOD=1.0        # reward for eating
SNAKE_R_DEATH=-1.0      # wall / self collision (terminal)
SNAKE_R_WIN=10.0        # snake length == n_cells (terminal, the objective)
SNAKE_R_STEP=-0.001     # every non-terminal step (must satisfy |R_STEP|/(1-GAMMA) < |R_DEATH|)
SNAKE_SHAPING_COEF=0.0  # potential-based shaping weight; 0 disables (default)

# --- PPO (sb3-contrib MaskablePPO) ------------------------------------------------------------
SNAKE_N_ENVS=4096       # batched environments in the single-process SnakeVecEnv (docs/benchmark.md)
SNAKE_TOTAL_TIMESTEPS=20000000
SNAKE_N_STEPS=64        # rollout length per env (rollout size = N_STEPS * N_ENVS)
SNAKE_BATCH_SIZE=8192   # minibatch size; must divide N_STEPS * N_ENVS (docs/benchmark.md)
SNAKE_N_EPOCHS=4
SNAKE_GAMMA=0.99
SNAKE_GAE_LAMBDA=0.95
SNAKE_LR_START=0.0003   # linear schedule start -> end
SNAKE_LR_END=0.00001
SNAKE_CLIP_START=0.2    # linear clip-range schedule start -> end
SNAKE_CLIP_END=0.05
SNAKE_ENT_COEF=0.01
SNAKE_VF_COEF=0.5
SNAKE_MAX_GRAD_NORM=0.5
SNAKE_TARGET_KL=0.03
SNAKE_NET_WIDTH=512     # MLP hidden width for both policy and value heads ([W, W])
SNAKE_DEVICE=auto       # auto | cpu | cuda (the benchmark writes the winning value here)
SNAKE_TORCH_THREADS=8   # torch.set_num_threads (8 beat 1 on every benchmark row)
SNAKE_SEED=0

# --- curriculum (Backplay reverse curriculum along the Hamiltonian route) ---------------------
SNAKE_CURRICULUM=1          # 1 = on, 0 = off
SNAKE_CURRICULUM_WINDOW=8   # start length is sampled from [hi - WINDOW, hi]
SNAKE_CURRICULUM_DELTA=0    # frontier step; 0 -> max(1, n_cells // 64)
SNAKE_CURRICULUM_RHO=0.2    # advance the frontier when curriculum success rate exceeds RHO
SNAKE_CURRICULUM_MIN_EPS=200
SNAKE_P_TRUE_START=0.2      # fraction of resets that always start from length 1

# --- evaluation -------------------------------------------------------------------------------
SNAKE_EVAL_EPISODES=100
SNAKE_EVAL_EVERY=2097152    # env steps between in-training evaluations (>= N_STEPS * N_ENVS)
SNAKE_CKPT_EVERY=8388608    # env steps between checkpoints
SNAKE_EVAL_SEEDS=0,1,2
SNAKE_BENCH_STEPS=200000    # bench: PPO timesteps per benchmark row

# --- paths / phase arguments ------------------------------------------------------------------
SNAKE_RUNS_DIR=runs
SNAKE_RUN_NAME=run
SNAKE_MODEL_PATH=           # evaluate: path to a saved MaskablePPO .zip (empty = scripted policy)
SNAKE_POLICY=route          # evaluate: route | random (when MODEL_PATH is empty)
