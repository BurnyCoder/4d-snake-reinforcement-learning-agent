# Experiment 04 (headline): 4^4 board (256 cells), PPO with Backplay along the cycle.
# Gate relaxed after exp03b stalled at 83% success with rho=0.9: advance at 80%, 16-cell window, 8-cell steps
SNAKE_RUN_NAME=exp04_ppo_4x4
SNAKE_SIZE=4
SNAKE_NDIM=4
SNAKE_CURRICULUM=1
SNAKE_CURRICULUM_RHO=0.8
SNAKE_CURRICULUM_WINDOW=16
SNAKE_CURRICULUM_DELTA=8
SNAKE_CURRICULUM_MIN_EPS=500
SNAKE_N_ENVS=4096
SNAKE_N_STEPS=64
SNAKE_BATCH_SIZE=8192
SNAKE_TOTAL_TIMESTEPS=100000000
SNAKE_EVAL_EVERY=2097152
SNAKE_CKPT_EVERY=8388608
