# Experiment 05: imitation warm start on 4^4 - behaviour-clone the route follower (all-length starts),
# then evaluate the cloned policy alone; fine-tune with `train --set model_path=<run>/bc_model.zip`
SNAKE_RUN_NAME=exp05_bc_4x4
SNAKE_SIZE=4
SNAKE_NDIM=4
SNAKE_N_ENVS=4096
SNAKE_N_STEPS=64
SNAKE_BATCH_SIZE=8192
SNAKE_BC_EPOCHS=20
SNAKE_BC_LR=0.001
