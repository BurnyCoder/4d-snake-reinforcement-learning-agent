# Experiment 05b: PPO fine-tuning of the behaviour-cloned 4^4 policy (exp05) from the true start.
# Gentle settings so RL improves speed without destroying the cloned cycle-following policy:
# lower learning rate, no entropy bonus, smaller clip range, no curriculum.
SNAKE_RUN_NAME=exp05b_ppo_4x4_from_bc
SNAKE_SIZE=4
SNAKE_NDIM=4
SNAKE_CURRICULUM=0
SNAKE_N_ENVS=4096
SNAKE_N_STEPS=64
SNAKE_BATCH_SIZE=8192
SNAKE_LR_START=0.0001
SNAKE_LR_END=0.00001
SNAKE_CLIP_START=0.1
SNAKE_CLIP_END=0.05
SNAKE_ENT_COEF=0.0
SNAKE_TOTAL_TIMESTEPS=20000000
SNAKE_EVAL_EVERY=2097152
SNAKE_CKPT_EVERY=8388608
